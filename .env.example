# Copy to .env and fill in. NEVER commit .env - this repository is public.
# Secrets/tokens must not contain spaces or quotes. Generate random secrets with e.g.:  openssl rand -hex 32

# --- Required -------------------------------------------------------------------------------------

# Steam Game Server Login Token (GSLT) for app 730: https://steamcommunity.com/dev/managegameservers
# Without it outside players cannot find/join the server over the internet.
SRCDS_TOKEN=

# RCON password; the web panel uses it to control the server at cs2:27015.
# Only letters, digits and . _ + = @ % - are accepted (it passes through the server's start script).
RCON_PASSWORD=

# Secret for the web panel's session cookies. Use a long random value.
SESSION_SECRET=

# Shared secret MatchZy sends in the X-Events-Token header to http://web:8080/api/matchzy/events.
# Only letters, digits and . _ ~ + = - are accepted.
MATCHZY_EVENTS_TOKEN=

# Steam group: the 64-bit group ID (starts with 10358279...) or the group's custom URL name (e.g. zandank).
# Members become admins in-game (SteamGroupAdmins plugin) and may use the controls on the web panel.
# The 64-bit ID is shown at https://steamcommunity.com/groups/<name>/memberslistxml/?xml=1
STEAM_GROUP_ID=

# Cloudflare Tunnel token (Cloudflare Zero Trust > Networks > Tunnels > your tunnel > install command).
# The tunnel's public hostname cs2.zandank.com must point to service http://web:8080.
TUNNEL_TOKEN=

# --- Optional -------------------------------------------------------------------------------------

# Public address players join the game with: your WAN IP or a DNS-only (grey cloud, NOT proxied) hostname,
# plus port, e.g. 203.0.113.5:27015. Set this! Without it the panel falls back to <PUBLIC_URL host>:27015
# (cs2.zandank.com:27015), which goes through Cloudflare and does not carry game UDP traffic.
CONNECT_ADDRESS=

# Join password for the game server (empty = no password). Same character rules as RCON_PASSWORD.
SERVER_PASSWORD=

# Optional web panel map pool, comma-separated (empty = default Active Duty:
# de_ancient,de_anubis,de_cache,de_dust2,de_inferno,de_mirage,de_nuke).
MAP_POOL=

# Steam Web API key (https://steamcommunity.com/dev/apikey); lets the web panel show names/avatars.
STEAM_API_KEY=

# Public URL of the web panel, used as the Steam OpenID return URL. Served via the Cloudflare Tunnel.
PUBLIC_URL=https://cs2.zandank.com

# Host folder for all persistent data (Unraid appdata share). Subfolders: cs2-data (~60 GB game files),
# demos (MatchZy demos, shared read-only with web), web (panel database).
APPDATA=/mnt/user/appdata/cs2-stack
# Optional: CS2 game install folder (the dir containing game/csgo). Defaults to ${APPDATA}/cs2-data.
# Set this to reuse an existing install, e.g. CS2_DATA=/mnt/user/appdata/old-cs2-install
CS2_DATA=

# LAN port for the web panel (the public route is the tunnel; no port-forward needed).
WEB_PORT=8080

# --- Optional game-server tweaks (not part of the shared contract) ---------------------------------

# Name shown in the server browser.
CS2_SERVERNAME=CS2 Practice & Scrims
# 5v5 + one coach per team.
CS2_MAXPLAYERS=13
# Map loaded on container start.
CS2_STARTMAP=de_mirage
# CSTV password (CSTV port 27020 is not published by default; only needed if you publish it).
TV_PASSWORD=
# 1 = make steamcmd verify all game files on next start (slow); use if the install is corrupted.
STEAMAPPVALIDATE=0
TZ=Europe/Amsterdam
