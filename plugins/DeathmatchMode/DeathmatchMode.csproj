<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- CounterStrikeSharp 1.0.380 (2026-11-12) ships lib/net10.0 only and hosts the .NET 10 runtime. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>DeathmatchMode</AssemblyName>
    <RootNamespace>DeathmatchMode</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned. Provided by the server at runtime, so it is not copied into the output folder. -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.380">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
